{
  "expo": {
    "name": "photo-album-print",
    "slug": "photo-album-print",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleLocalizations": ["fr", "en"],
        "NSCameraUsageDescription": "L'app utilise l'appareil photo pour prendre les photos de votre album.",
        "NSPhotoLibraryUsageDescription": "L'app accède à votre galerie pour importer des photos dans votre album.",
        "NSLocationWhenInUseUsageDescription": "L'app utilise la localisation des photos pour indiquer le lieu de prise de vue sous chacune."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "L'app accède à votre galerie pour importer des photos dans votre album.",
          "cameraPermission": "L'app utilise l'appareil photo pour prendre les photos de votre album."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "L'app enregistre les photos prises dans votre photothèque."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e309c8a1-b634-41dc-989c-51ac6e50e4fa"
      }
    },
    "owner": "boccaras-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e309c8a1-b634-41dc-989c-51ac6e50e4fa"
    }
  }
}
