# Remplace .gitignore pour l'archive envoyée à EAS Build.
# Doit donc reprendre TOUT .gitignore, plus l'outillage local.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# QR codes générés (dev local et partage)
expo-qr.png
partage-qr.png

# Outillage agents : .agents/skills/* sont des liens symboliques vers .claude/skills.
# Windows refuse de les recréer dans le clone temporaire d'EAS
# (EPERM: operation not permitted, symlink ...) → build en échec.
.agents/
.claude/
skills-lock.json

# Notes et captures de travail à la racine, inutiles au build.
# Motifs ancrés avec / pour ne surtout pas toucher assets/ (icônes, polices).
/*.doc
/*.png
/*.jpg
/*.JPG
/*.jpeg
